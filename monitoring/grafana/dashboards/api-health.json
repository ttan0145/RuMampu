{
  "uid": "rumampu-api-health",
  "title": "RuMampu · API health",
  "description": "Uptime and response time of the local RuMampu API and web app.",
  "tags": [
    "rumampu"
  ],
  "timezone": "Asia/Kuala_Lumpur",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### RuMampu API health\nThe probe checks the local API and web app every 15 seconds (house price data every minute). **Up** means the last check returned HTTP 200. Times are Malaysia time."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "API",
      "description": "GET /api/v1/health/ on the Django backend (port 8000).",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "probe_success{name=\"api_health\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "0": {
                  "text": "Down",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Web app",
      "description": "The Expo web app on port 8081.",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "probe_success{name=\"web_app\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "0": {
                  "text": "Down",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "House price data",
      "description": "GET /api/v1/housing/price-explorer/trend/: needs the database and the price model.",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "probe_success{name=\"price_explorer\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "0": {
                  "text": "Down",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "API uptime in this time range",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Share of API checks that passed during the selected time range.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "avg_over_time(probe_success{name=\"api_health\"}[$__range]) * 100",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Response time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Response time by check",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 9
      },
      "description": "How long each check took. A rising line means the server or the database is slowing down.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "probe_duration_seconds",
          "legendFormat": "{{label}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    },
    {
      "type": "bargauge",
      "title": "Response time now",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "probe_duration_seconds",
          "legendFormat": "{{label}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 8
    },
    {
      "type": "row",
      "title": "Up and down",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 9
    },
    {
      "type": "state-timeline",
      "title": "Up and down over time",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 16,
        "h": 7
      },
      "description": "Green while a check passes, red while it fails.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "probe_success",
          "legendFormat": "{{label}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "0": {
                  "text": "Down",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Last result per check",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "description": "HTTP status of the latest check. 0 means the server could not be reached.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "probe_http_status_code",
          "legendFormat": "{{label}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "name": true,
              "url": true
            },
            "renameByName": {
              "label": "Check",
              "Value": "HTTP status"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Failed checks per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "rumampu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 7
      },
      "description": "Failed checks in each clock hour. Each bar counts only its own hour, so an outage does not linger into later hours.",
      "interval": "1h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rumampu-prometheus"
          },
          "expr": "round(increase(probe_failures_total[$__interval]))",
          "legendFormat": "{{label}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "axisSoftMax": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 12
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
