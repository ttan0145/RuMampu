{
  "builds": [
    {
      "src": "backend/config/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/config/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/retention/run/",
      "schedule": "15 2 * * *"
    }
  ]
}
