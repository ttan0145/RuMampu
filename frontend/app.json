{
  "expo": {
    "name": "RuMampu",
    "slug": "rumampu",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/RuMampu_AppIcon_Ruma_nobadge_master_2048.png",

    "scheme": "rumampu",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.rumampu"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/RuMampu_AppIcon_Ruma_nobadge_master_2048.png",
        "backgroundColor": "#5F9EA0"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.rumampu"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/RuMampu_AppIcon_Ruma_nobadge_master_2048.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/RuMampu_AppIcon_Ruma_nobadge_master_2048.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "RuMampu uses the camera to photograph a receipt or an earnings page so you can add it to your record.",
          "photosPermission": "RuMampu opens your photos so you can pick a receipt or an earnings screenshot to add to your record."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "c059b1c3-1342-4204-a453-ef86794b73c4"
      }
    }
  }
}