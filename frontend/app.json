{
  "expo": {
    "name": "RuMampu",
    "slug": "rumampu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rumampu",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.rumampu"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#28343A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.rumampu"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "RuMampu uses the camera to photograph a receipt or an earnings page so you can add it to your record.",
          "photosPermission": "RuMampu opens your photos so you can pick a receipt or an earnings screenshot to add to your record."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c059b1c3-1342-4204-a453-ef86794b73c4"
      }
    }
  }
}
