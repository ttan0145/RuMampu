{
  "name": "rumampu",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:traceability": "node scripts/check-e2e-traceability.mjs",
    "test:e2e": "npm run test:e2e:traceability && playwright test",
    "test:e2e:acceptance": "npm run test:e2e:traceability && playwright test e2e/epic1.spec.ts e2e/epic2.spec.ts",
    "test:e2e:epic1": "npm run test:e2e:traceability && playwright test e2e/epic1.spec.ts",
    "test:e2e:epic2": "npm run test:e2e:traceability && playwright test e2e/epic2.spec.ts",
    "test:e2e:epic3": "playwright test e2e/epic3.spec.ts",
    "test:e2e:epic4": "playwright test e2e/epic4.spec.ts",
    "test:e2e:epic8": "playwright test e2e/epic8.spec.ts",
    "test:e2e:housing": "playwright test e2e/housing-integration.spec.ts",
    "test:live": "node scripts/run-live-tests.mjs",
    "test:live:report": "playwright show-report ../output/playwright/live/report"
  },
  "private": true
}
