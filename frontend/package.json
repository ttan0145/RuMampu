{
  "name": "rumampu",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "expo": "^57.0.27",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.unit.json --noEmit",
    "test:unit": "node --experimental-strip-types --test \"unit/*.test.ts\"",
    "test:e2e:traceability": "node scripts/check-e2e-traceability.mjs",
    "test:e2e": "npm run test:e2e:traceability && playwright test",
    "test:e2e:acceptance": "npm run test:e2e:traceability && playwright test e2e/epic1.spec.ts e2e/epic2.spec.ts",
    "test:e2e:epic1": "npm run test:e2e:traceability && playwright test e2e/epic1.spec.ts",
    "test:e2e:epic2": "npm run test:e2e:traceability && playwright test e2e/epic2.spec.ts",
    "test:e2e:epic5": "npm run test:e2e:traceability && playwright test e2e/epic5.spec.ts e2e/epic5-upfront-fees.spec.ts e2e/epic5-learn.spec.ts",
    "test:e2e:epic3": "playwright test e2e/epic3.spec.ts",
    "test:e2e:epic4": "playwright test e2e/epic4.spec.ts",
    "test:e2e:epic8": "playwright test e2e/epic8.spec.ts",
    "test:e2e:epic6": "playwright test e2e/epic6.spec.ts",
    "test:e2e:epic9": "playwright test e2e/epic9.spec.ts",
    "test:e2e:epic10": "playwright test e2e/epic10.spec.ts",
    "test:e2e:iteration3": "playwright test e2e/iteration3-epic7-8.spec.ts",
    "test:e2e:housing": "playwright test e2e/housing-integration.spec.ts",
    "test:live": "node scripts/run-live-tests.mjs",
    "test:live:report": "playwright show-report ../output/playwright/live/report"
  },
  "private": true
}
