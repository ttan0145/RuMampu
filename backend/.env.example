SECRET_KEY=replace-this-outside-local-development
DEBUG=True
ENABLE_TEST_SCENARIOS=False
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Leave PGHOST empty for the local SQLite database. Set all PG* values for Neon/PostgreSQL.
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGPORT=5432
PGSSLMODE=require
